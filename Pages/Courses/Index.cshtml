@page
@model Task16WebApp.Pages.Courses.IndexModel

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Courses</h1>
            <p class="text-muted mb-0">
                Manage all courses in CampusFlow
            </p>
        </div>

        <a asp-page="Create" class="btn btn-primary">
            + Add Course
        </a>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]

            <button type="button" class="btn-close" data-bs-dismiss="alert">
            </button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }


    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get" class="row g-3">

                <div class="col-md-5">
                    <label class="form-label">
                        Search Course
                    </label>

                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control"
                           placeholder="Enter course name..." />
                </div>


                <div class="col-md-4">
                    <label class="form-label">
                        Credit Hours
                    </label>

                    <select name="creditHours" class="form-select">

                        <option value="">
                            All Credit Hours
                        </option>

                        <option value="1">
                            1 Credit Hour
                        </option>

                        <option value="2">
                            2 Credit Hours
                        </option>

                        <option value="3">
                            3 Credit Hours
                        </option>

                        <option value="4">
                            4 Credit Hours
                        </option>

                        <option value="5">
                            5 Credit Hours
                        </option>

                    </select>
                </div>


                <div class="col-md-3 d-flex align-items-end">

                    <button type="submit" class="btn btn-primary me-2">
                        Search
                    </button>

                    <a asp-page="Index" class="btn btn-outline-secondary">
                        Reset
                    </a>

                </div>

            </form>

        </div>
    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Course Name</th>
                            <th>Credit Hours</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Courses.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">

                                    No courses found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var course in Model.Courses)
                            {
                                <tr>

                                    <td>
                                        @course.Name
                                    </td>

                                    <td>
                                        @course.CreditHours
                                    </td>

                                    <td>

                                        <a asp-page="Details" asp-route-id="@course.CourseId" class="btn btn-sm btn-info">
                                            Details
                                        </a>

                                        <a asp-page="Edit" asp-route-id="@course.CourseId" class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-page="Delete" asp-route-id="@course.CourseId" class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>