@page
@model Task16WebApp.Pages.Courses.EditModel

<div class="container mt-4">

    <h1>Edit Course</h1>
    <p class="text-muted">Update course information</p>

    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <form method="post">

                <input type="hidden"
                       asp-for="Course.CourseId" />

                <div class="mb-3">
                    <label asp-for="Course.Name"
                           class="form-label">
                        Course Name
                    </label>

                    <input asp-for="Course.Name"
                           class="form-control" />

                    <span asp-validation-for="Course.Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Course.CreditHours"
                           class="form-label">
                        Credit Hours
                    </label>

                    <input asp-for="Course.CreditHours"
                           class="form-control" />

                    <span asp-validation-for="Course.CreditHours"
                          class="text-danger"></span>
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-page="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>